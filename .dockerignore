# Compiled Python files
**/*.pyc
**/__pycache__/

.git
.venv/
.uv_cache/
.ruff_cache/
.mypy_cache/
restart.sh
start.sh
uwsgi.ini

# IDEs
.vscode/

# Mac doodads
.DS_Store

# Image files (uncomment if you want to exclude)
# *.jpg
# *.raw
# *.png

# Jupyter
*.ipynb

# Application storage
config/
input/
media/
state/
data/
scratch/

# Source dirs not used at runtime
clio-elm/
client/

# JS dependencies. The image serves the prebuilt static/ bundle and never runs
# npm, so `COPY . .` would otherwise bake ~1.4 GB of these into the layer.
node_modules/
**/node_modules/
.pytest_cache/

# Temporary files
tmp/
*.log

# Keep these files for uv
!pyproject.toml
!uv.lock

